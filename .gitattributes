# Normalize all text files to LF on commit
* text=auto eol=lf

# Ensure these extensions always use LF
*.ts text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.json text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.cs text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
